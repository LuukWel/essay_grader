# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Grading model, used for AI assessments, overall feedback and essay summaries.
# Must be a model you have pulled (run: ollama list)
OLLAMA_MODEL=qwen2.5:7b

# Embedding model for the "similar essays" panel (Dashboard condition)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Topic model (Dashboard condition), see python/topic_model.py
# Labelling model, served by Ollama (run: ollama pull gemma2:9b)
TOPIC_LLM_MODEL=gemma2:9b
# Clustering embeddings, downloaded by sentence-transformers on first use
TOPIC_EMBED_MODEL=BAAI/bge-large-en-v1.5

# Optional
# GRADING_DB_PATH=data/grading.db
# TOPIC_PYTHON=python
# LLM_PRECOMPUTE_TIMEOUT_MS=180000
# TOPIC_MODEL_TIMEOUT_MS=900000
