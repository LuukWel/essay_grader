# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed template; copy it to .env.local
.env*
!.env.example

# data: only commit what the app needs to run — the sample set and the rubric.
# Everything else (datasets, other essay sets, topic assignments, grading.db
# and its backups) stays local.
/data/*
!/data/subset_DEMO.csv
!/data/rubric/

# scripts: study backup/export tooling stays local (the topic model lives in python/)
/scripts/*

# python
.venv/
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal planning notes 
/cohort_essay_grader_improvement_plan.md
